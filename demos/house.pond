# pond: a house by the pool.               ./pond --script demos/house.pond
#
# The 12 m pool sunk in a terrace, a low house with a glass wall under a deep
# roof, a cabana, palms, a lawn running out to the hills.  A day, a breeze,
# some rain at night, and the round pool.  Four minutes, on a loop.

at 0     clear  shape rect  preset pool  glass opaque  floor tiles  setting house  damping 0.05
at 0     rain off  breeze off  wind 0  paddle off  boat off  floats 0  shake off  view off
at 0     sun-elev 55  sun-azim 100
at 0     camera 35,32,1.9
at 0     say "a house by the pool"
at 2     yaw -= 50 over 40
at 4     drop 0.3,0.6 0.05
+3       drop 0.7,0.35 0.04
at 20    breeze on  breeze-gain 0.4
at 20    say "a breath of wind across the water"
at 44    pitch 14 over 16  dist 1.3 over 16
at 44    say "from the lawn"
at 62    floats 4
at 66    yaw += 40 over 50
at 80    sun-elev 4 over 40  sun-azim 250 over 40
at 82    say "afternoon into dusk"
at 122   sun-elev -15 over 12
at 124   say "night: the rooms light up"
at 140   rain on  rain-rate 3
at 140   say "rain at night"
at 160   rain off  floats 0
at 162   sun-elev 55 over 16  sun-azim 100 over 16  camera 20,34,1.9 over 16
at 164   say "morning"
at 182   breeze off
at 184   clear
at 185   shape disk
at 185   camera 25,36,1.9
at 185   say "the round pool"
at 186   paddle on  paddle-span 1  paddle-freq 1.2  paddle-stroke 0.4  paddle-mark off
at 188   yaw += 60 over 40
at 228   paddle off  paddle-stroke 1  paddle-mark on
at 230   say ""
at 232   clear
at 233   shape rect
at 234   loop
