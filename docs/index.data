# pond: a boat and its wake.              ./pond --script demos/boat.pond
#
# A hull pressed on the water and driven round the basin leaves a Kelvin wake:
# transverse waves of length 2 pi U^2 / g behind it, divergent waves fanning out,
# the whole thing inside a half-angle of 19.5 degrees whatever the speed.

at 0     clear  preset pool  rain off  breeze off  paddle off  wind 0  floats 0
at 0     boat 0.2,0.5,0  boat-speed 0.4  gain 1  damping 0.03     # at the west side, heading east
at 0     camera 40,35,1.2
at 0     say "a hull under way: the Kelvin wake, 19.5 degrees either side whatever the speed"
at 10    yaw += 90 over 40
at 30    boat-speed 0.7 over 10
at 30    say "faster: the transverse waves lengthen as the speed squared; the angle does not change"
at 55    float 0.5,0.3  float 0.5,0.7  float 0.7,0.5  floats 6       # three placed, three anywhere
at 55    say "six floats, riding the wake"
at 60    dist 0.6 over 20   pitch 25 over 20
at 100   boat-speed 0.3 over 10
at 100   say "slow: a short wake, and the floats settle"
at 130   say ""
at 130   loop
# pond: a day.                              ./pond --script demos/day.pond
#
# The sun is a parameter.  Sweep its elevation and the light, the sky, the
# glints and the caustics follow: long grazing glints at dawn, a red Fresnel
# dusk, then the moon, sparse glints and stars.  The pool sits in its
# setting, so the house's shadow swings across the terrace and the water
# through the day, and its rooms light up at night.  Minutes, on a loop: a
# screen saver.

at 0     clear  shape rect  preset pool  rain off  paddle off  boat off  floats 0  glass 0  setting house
at 0     breeze on  breeze-gain 0.4
at 0     sun-azim 110  sun-elev -12
at 0     camera 10,16,1.5
at 0     say "night.  the moon on the water"
at 15    sun-elev 4 over 40
at 15    say "dawn: low sun on the house front, long glints on the water"
at 30    say ""
at 40    yaw += 50 over 120
at 55    sun-elev 60 over 70   sun-azim 200 over 70
at 60    say "noon"
at 125   say ""
at 130   sun-elev 2 over 60   sun-azim 260 over 60
at 150   say "evening: the sun behind the house, its shadow across the pool"
at 190   sun-elev -15 over 30
at 200   say "and night again"
at 230   say ""
at 235   loop
# dispersion: one drop, and the long waves outrun the short ones.
#                                      ./pond --script demos/dispersion.pond

at 0    clear  preset 3  glass none  damping 0.01  warp 1  rain off  paddle off  breeze off
at 0    camera 30,60,1.6
at 0    say "one drop in a still pool"
at 2    drop 0.5,0.5 0.05
at 3    say "the long waves run ahead and the short ones lag: gravity waves disperse"
at 3    dist 2.2 over 20

at 25   say "the same, eight times slower"
at 25   warp 0.125
at 26   drop 0.3,0.7 0.04
at 50   warp 1

at 50   say "the tray: capillary waves, where the short ones are the fast ones"
at 50   clear  preset 1  glass none  damping 0.05
at 51   camera 30,60,1.6
at 53   drop 0.5,0.5 0.05
at 54   warp 0.25

at 75   warp 1   say ""
at 75   loop
# pond: a house by the pool.               ./pond --script demos/house.pond
#
# The 12 m pool sunk in a terrace, a low house with a glass wall under a deep
# roof, a cabana, palms, a lawn running out to the hills.  A day, a breeze,
# some rain at night, and the round pool.  Four minutes, on a loop.

at 0     clear  shape rect  preset pool  glass opaque  floor tiles  setting house  damping 0.05
at 0     rain off  breeze off  wind 0  paddle off  boat off  floats 0  shake off  view off
at 0     sun-elev 55  sun-azim 100
at 0     camera 35,32,1.9
at 0     say "a house by the pool"
at 2     yaw -= 50 over 40
at 4     drop 0.3,0.6 0.05
+3       drop 0.7,0.35 0.04
at 20    breeze on  breeze-gain 0.4
at 20    say "a breath of wind across the water"
at 44    pitch 14 over 16  dist 1.3 over 16
at 44    say "from the lawn"
at 62    floats 4
at 66    yaw += 40 over 50
at 80    sun-elev 4 over 40  sun-azim 250 over 40
at 82    say "afternoon into dusk"
at 122   sun-elev -15 over 12
at 124   say "night: the rooms light up"
at 140   rain on  rain-rate 3
at 140   say "rain at night"
at 160   rain off  floats 0
at 162   sun-elev 55 over 16  sun-azim 100 over 16  camera 20,34,1.9 over 16
at 164   say "morning"
at 182   breeze off
at 184   clear
at 185   shape disk
at 185   camera 25,36,1.9
at 185   say "the round pool"
at 186   paddle on  paddle-span 1  paddle-freq 1.2  paddle-stroke 0.4  paddle-mark off
at 188   yaw += 60 over 40
at 228   paddle off  paddle-stroke 1  paddle-mark on
at 230   say ""
at 232   clear
at 233   shape rect
at 234   loop
# pond: poolside.                          ./pond --script demos/poolside.pond
#
# Standing at the water's edge by the steps, as someone with a camera would:
# the video look, the 12 m pool at 1.5 m deep in its setting, a light breeze in
# gusts.  The steps throw their shadows down onto each other through the water,
# the caustics wander over the mosaic, the sun glitters off the far side.

at 0     clear  shape rect  preset pool  depth 1.5  glass opaque  floor tiles  setting house  look video
at 0     rain off  paddle off  boat off  floats 0  shake off  wind 0  damping 0.04
at 0     breeze on  breeze-gain 0.8  gusts on
at 0     sun-elev 45  sun-azim 60
at 0     cam-x -0.29  cam-z 0.40  camera 160,38,0.30
at 0     say "poolside: the steps"
at 6     drop 0.20,0.80 0.04
at 20    yaw += 25 over 40   pitch 30 over 40
at 40    say ""
at 64    say "along to the bench"
at 64    cam-x -0.42 over 30  cam-z 0.05 over 30  yaw 120 over 30  dist 0.35 over 30
at 100   say "the sun lower: longer shadows, warmer light"
at 100   sun-elev 18 over 40  sun-azim 80 over 40
at 104   cam-x -0.29 over 30  cam-z 0.40 over 30  yaw 165 over 30  pitch 36 over 30  dist 0.30 over 30
at 145   say ""
at 150   sun-elev 45 over 15  sun-azim 60 over 15
at 168   loop
# the ring maker.                      ./pond --script demos/rings.pond

at 0    clear  shape disk  preset 3  glass glass+bottom  rain off  breeze off
at 0    paddle on  paddle-span 1  paddle-freq 1.0  paddle-pos 0.5
at 0    camera 0,70,1.2
at 0    say "a disk with its whole rim as the wavemaker: rings that converge on the centre"
at 3    yaw += 360 over 120

at 20   say "lower down: the rings pile up where they meet"
at 20   pitch 25 over 25
at 50   say "faster: the pattern tightens"
at 50   paddle-freq 1.8 over 20
at 80   say "a sector of the rim instead: a fan, and its echo off the far side"
at 80   paddle-span 0.15 over 6
at 90   paddle-pos += 1 over 30

at 125  say ""
at 125  paddle-span 1  paddle-freq 1.0
at 125  loop
# pond: the basin shaken.                 ./pond --script demos/shake.pond
#
# Shaken vertically at frequency F, the water answers at F/2: every mode is a
# Mathieu oscillator, and the ones near F/2 are parametrically unstable once
# the shaking beats the damping (Faraday, 1831).  Shoved sideways, it sloshes
# at its fundamental period (the seiche).

at 0     clear  preset pond  rain off  breeze off  paddle off  boat off  floats 0
at 0     camera 35,30,1.2  gain 1
at 0     say "a 3 m pond, still.  shoved sideways: the seiche, 2.9 s a swing"
at 2     jolt 0.4,0
at 25    jolt 0,0.4
at 25    say "and across"
at 45    clear  shake on  shake-amp 0.5  shake-freq 3
at 45    say "shaken at 3 Hz, half a g: Faraday waves grow at 1.5 Hz from nothing"
at 60    yaw += 90 over 40
at 80    shake-freq 2 over 10
at 80    say "2 Hz: longer waves, at 1 Hz"
at 110   shake-freq 5 over 10
at 110   say "5 Hz: a finer pattern, at 2.5 Hz"
at 135   shake-amp 0.15 over 10
at 135   say "the shaking eased to 0.15 g: below the threshold, the waves die away"
at 165   clear  preset tray  shake on  shake-amp 0.6  shake-freq 8  gain 4  camera 30,35,0.9
at 165   say "the 30 cm tray at 8 Hz: millimetre ripples at 4 Hz, drawn at four times their height"
at 175   yaw += 60 over 30
at 215   shake off  gain 1
at 215   say ""
at 220   loop
# pond: everything it does, once.          ./pond --script demos/showcase.pond
#
# Ten minutes through every source, basin, container, setting, light and sound the
# program has, from the 30 cm tray to the 80 m sea.  Loops.  Escape stops it;
# any key on a parameter the script is moving takes that parameter over.
#
# The cameras are framed for 16:9 with the settings box showing.  Where a
# drive would pile steep crests into a closed basin, the damping is raised
# for that scene: the basin then reads like a pool with overflow gutters.

# --- the tray: millimetre water ------------------------------------------
at 0     clear  shape rect  preset tray  glass opaque  floor checker  warp 1  gain 1  damping 0.03
at 0     rain off  breeze off  wind 0  paddle off  boat off  floats 0  shake off
at 0     nonlinear off  view off  paused off  paddle-mark on  paddle-stroke 1  drop-size 0  setting none
at 0     sun-elev 50  sun-azim 200
at 0     camera 30,50,2.0
at 0     say "the 30 cm tray: millimetre water, where surface tension rules"
at 2     drop 0.5,0.5 0.05
at 4     say "at quarter speed: here the short ripples outrun the long ones"
at 4     warp 0.25
at 5     drop 0.3,0.65 0.04
at 16    warp 1  gain 4 over 4
at 16    say "drawn at four times their height"
at 18    drop random
+2       drop random
+2       drop random
at 24    say "the same field as a height map"
at 24    view on
at 31    view off  gain 1

# --- the pond: rain, the seiche, Faraday ---------------------------------
at 33    clear  preset pond  floor sand  glass floor
at 33    camera 35,40,2.4
at 33    say "a 3 m pond in the rain: every drop rings, and pulls a bubble under"
at 33    rain on  rain-rate 2
at 42    rain-rate 12 over 10
at 42    say "harder"
at 54    drop-size 0.05 over 4
at 54    say "bigger drops"
at 64    rain off  drop-size 0
at 66    say "shoved sideways: the seiche, one slow slosh"
at 66    jolt 0.4,0
at 80    jolt 0,0.4
at 80    say "and across"
at 94    clear  shake on  shake-amp 0.5  shake-freq 3
at 94    say "shaken up and down at 3 Hz, half a g: Faraday waves grow at 1.5 Hz"
at 97    yaw += 60 over 30
at 116   shake-freq 5 over 8  shake-amp 0.25 over 8
at 116   say "5 Hz: a finer pattern, at 2.5 Hz"
at 134   shake off

# --- the pool: the wavemaker ---------------------------------------------
at 137   clear  preset pool  floor tiles  glass opaque  damping 0.08
at 137   camera 30,45,2.1
at 137   say "the 12 m pool: a wall-wide wavemaker at 0.8 Hz"
at 137   paddle on  paddle-wall x=0  paddle-pos 0.5  paddle-span 1  paddle-freq 0.8
at 150   paddle-freq 1.6 over 10  paddle-stroke 0.6 over 10
at 150   say "twice the frequency: the water picks a quarter of the wavelength"
at 164   paddle-span 0.1 over 6  paddle-stroke 0.5 over 6
at 164   say "a tenth of the wall: a fan"
at 172   paddle-pos 0.15 over 10
at 183   paddle-wall y=0  paddle-pos 0.5
at 183   say "the next wall"
at 184   yaw += 90 over 20
at 198   paddle-span 1  paddle-freq 1.0  paddle-stroke 2 over 6
at 198   say "driven harder: steeper crests"
at 206   nonlinear on
at 206   say "the nonlinear correction on: crests sharpen, troughs flatten"
at 221   nonlinear off  paddle-stroke 1

# --- the containers --------------------------------------------------------
at 223   glass floor  pitch 30 over 10
at 223   say "the containers.  floor only"
at 233   glass glass
at 233   say "glass walls: light shafts through the water"
at 245   glass glass+bottom
at 245   say "glass all round"
at 255   glass none
at 255   say "and nothing: the water alone"
at 265   glass opaque  paddle off

# --- a boat and its floats -----------------------------------------------
at 267   clear  damping 0.12  boat 0.15,0.5,0  boat-speed 0.4
at 267   camera 40,38,1.9 over 6
at 267   say "a hull under way: the Kelvin wake, 19.5 degrees either side"
at 283   boat-speed 0.55 over 10
at 283   say "faster: longer waves, the same angle"
at 298   float 0.5,0.3  float 0.5,0.7  float random  floats 6
at 298   say "six floats: they ride the wake and drift with the water"
at 313   boat-speed 0.3 over 8
at 313   say "slower: a short wake, and the floats settle"
at 328   boat off  floats 0  damping 0.03

# --- the house, and the sun -------------------------------------------------
at 329   setting house  breeze on  breeze-gain 0.5  sun-azim 100
at 329   camera 15,22,1.7 over 8
at 329   say "a setting: the pool in a terrace, a house, a cabana, palms"
at 337   yaw += 40 over 60
at 341   sun-elev 4 over 20  sun-azim 250 over 20
at 341   say "the sun is a parameter.  dusk: long glints, a red sky"
at 363   sun-elev -15 over 12
at 365   say "night: the moon on the water, and the rooms lit"
at 381   sun-elev 50 over 10  sun-azim 100 over 10
at 381   say "and morning"
at 391   breeze off

# --- the disk ---------------------------------------------------------------
at 393   clear
at 394   shape disk  preset pool  glass opaque  floor tiles  damping 0.05
at 394   sun-elev 35 over 4  sun-azim 60 over 4
at 394   paddle on  paddle-span 1  paddle-freq 1.2  paddle-pos 0.5  paddle-stroke 0.4
at 394   camera 20,40,1.9
at 394   say "a round pool, the whole rim a wavemaker: rings converging on the centre"
at 400   yaw += 120 over 50
at 410   paddle-span 0.15 over 6
at 410   say "a sector of the rim, going round"
at 417   paddle-pos += 1 over 25
at 444   paused on
at 444   say "paused: time stops, and the sound with it"
at 450   paused off
at 450   say ""
at 452   paddle off  paddle-stroke 1  breeze-gain 1

# --- the sea ----------------------------------------------------------------
at 454   clear
at 455   shape rect  preset sea  glass opaque  floor sand  damping 0.05  setting none
at 455   sun-elev 50  sun-azim 200
at 455   wind 6  sound.breeze 1.5  sound.harsh 0.6
at 455   camera 40,28,1.7 over 10
at 455   say "the sea, 80 m of it, under a 6 m/s wind"
at 475   wind 14 over 25  sound.harsh 1.5 over 25
at 475   say "14 m/s: a fetch-limited chop, and the wind's sound rising with it"
at 505   yaw += 90 over 40
at 540   breeze off  wind 0  sound.harsh 0.6 over 10  sound.breeze 1 over 10
at 540   say "the wind drops: swell, the long waves that outlast it"
at 565   say ""
at 570   damping 0.03
at 570   loop
# the sea.                             ./pond --script demos/storm.pond

at 0    clear  preset 4  glass opaque  rain off  paddle off
at 0    breeze on  breeze-gain 1  sound.breeze 1.5  sound.harsh 0.6
at 0    camera 40,20,0.9
at 0    say "the sea, eighty metres of it, under a breeze"
at 2    yaw += 60 over 60

at 30   say "the wind rises"
at 30   breeze-gain 3 over 30   sound.harsh 1.5 over 30
at 70   say "and drops"
at 70   breeze-gain 0.3 over 40   sound.harsh 0.3 over 40
at 100  pitch 45 over 30   dist 1.4 over 30

at 130  say "swell: the long waves that outlast the wind"
at 130  breeze off

at 175  say ""
at 175  loop
# pond: a tour.                        ./pond --script demos/tour.pond
#
# One event per line: a time ("at 20", or "+5" after the line before), then
# parameter settings.  "over T" tweens a number there.  Escape stops it.

at 0     clear  preset 2  glass opaque  rain on  rain-rate 1.5  paddle off  breeze off
at 0     camera 35,42,1.5
at 0     say "a pond, three metres across, in the rain"
at 2     yaw += 90 over 30

at 20    say "a wavemaker at 1.2 Hz: the water chooses the wavelength"
at 20    rain off  paddle on  paddle-freq 1.2  paddle-span 1  paddle-wall x=0  paddle-pos 0.5
at 35    say "twice the frequency: a shorter, slower wave"
at 35    paddle-freq 2.4 over 8
at 50    say "a short paddle radiates a fan"
at 50    paddle-span 0.12 over 6
at 58    paddle-pos 0.15 over 12   pitch 60 over 12
at 72    paddle-pos 0.85 over 14

at 88    say "glass walls, and the light that comes through them"
at 88    glass glass   yaw += 120 over 40   pitch 30 over 20

at 110   say "a disk, with the whole rim as the wavemaker"
at 110   clear  paddle off
at 111   shape disk  paddle-span 1  paddle-freq 1.0  paddle on
at 112   camera 20,55,1.3 over 20

at 140   say "the sea: eighty metres, with a breeze"
at 140   paddle off  clear
at 141   shape rect  preset 4  breeze on  glass opaque
at 142   camera 40,25,1.0 over 30
at 175   breeze off

at 180   say ""
at 180   loop
# the wavemaker.                       ./pond --script demos/wavemaker.pond

at 0    clear  preset 3  glass floor  breeze off  rain off
at 0    paddle on  paddle-wall x=0  paddle-pos 0.5  paddle-span 1  paddle-freq 0.9
at 0    camera 30,52,1.7
at 0    say "a wall-wide wavemaker at 0.9 Hz: plane waves"

at 12   say "the frequency sweeps up: shorter waves, travelling slower"
at 12   paddle-freq 2.5 over 25
at 40   say "and down.  it stops at the tank's lowest mode: below that, nothing can answer"
at 40   paddle-freq 0.3 over 20

at 65   say "the same drive on a fifth of the wall"
at 65   paddle-freq 1.2   paddle-span 0.2 over 8
at 80   say "a point source, sliding along the wall"
at 80   paddle-span 0.05 over 5
at 86   paddle-pos 0.1 over 10
at 97   paddle-pos 0.9 over 14

at 113  say "the next wall"
at 113  paddle-wall y=0  paddle-pos 0.5  paddle-span 0.3
at 114  yaw += 90 over 20

at 135  say "wall-wide again: the reflection off the far wall makes a standing wave"
at 135  paddle-span 1  paddle-freq 1.6
at 136  pitch 70 over 20

at 160  say ""
at 160  loop
# pond: a wind sea.                        ./pond --script demos/wind.pond
#
# A fetch-limited sea for a wind over the basin's length (JONSWAP): the peak
# wavelength and the significant height both come from the wind speed alone.

at 0     clear  preset pond  rain off  paddle off  boat off  floats 0
at 0     wind 3  gain 1
at 0     camera 30,30,1.3
at 0     say "a 3 m/s breeze over a 3 m pond: the ripples a breath makes"
at 20    wind 6 over 20
at 20    say "6 m/s"
at 50    wind 10 over 20
at 50    say "10 m/s: height goes with the wind, wavelength with its 2/3 power"
at 80    floats 8
at 80    say "floats drift down the slopes and gather where the water does"
at 85    yaw += 120 over 40
at 130   preset sea  wind 12  camera 30,18,0.8
at 130   say "the sea preset, 12 m/s: as short a chop as the grid can hold"
at 140   boat on  boat-speed 0.5
at 140   say "and a boat through it"
at 150   yaw += 90 over 60
at 220   say ""
at 220   loop
